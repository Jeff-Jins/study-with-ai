#!/usr/bin/env python3
"""grow — study-with-ai 지식나무를 키우는 스크립트.

사용법:
  ./grow start "<가지 경로>" "<제목>"   학습 노트 만들기 (🌱 공부 중)
  ./grow done "<노트 경로>" [--force]   나무에 잎 추가 + 커밋 + push (🍃)
  ./grow refresh                      루트 README 다시 그리기
  ./grow list                         공부 중인 노트 보기
"""
from __future__ import annotations

import argparse
import datetime as dt
import re
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path
from urllib.parse import quote

DEFAULT_ROOT = Path(__file__).resolve().parent
TREE_DIR = "tree"
FORBIDDEN = re.compile(r'[\\/:*?"<>|#%]')
META_RE = re.compile(r"<!--\s*supervised:(.*?)-->")
TODO_RE = re.compile(r"^[ \t]*[-*] \[( |x|X)\] (.+?)[ \t]*$", re.MULTILINE)


class GrowError(Exception):
    """사용자에게 그대로 보여줄 오류."""


# ── 노트 텍스트 파싱 ─────────────────────────────────────────────


def slugify(title: str) -> str:
    s = FORBIDDEN.sub("", title).strip()
    s = re.sub(r"\s+", "-", s)
    s = re.sub(r"-{2,}", "-", s).strip("-.")
    if not s:
        raise GrowError(f"제목으로 폴더 이름을 만들 수 없습니다: {title!r}")
    return s


def parse_branch(branch: str) -> tuple[str, ...]:
    parts = []
    for raw in re.split(r"[/\\]", branch):
        seg = re.sub(r"\s+", " ", FORBIDDEN.sub("", raw)).strip()
        if not seg:
            continue
        if set(seg) == {"."}:
            raise GrowError("가지 이름에 '.'이나 '..'은 쓸 수 없습니다")
        parts.append(seg)
    if not parts:
        raise GrowError('가지를 하나 이상 지정하세요. 예: "CS/네트워크"')
    return tuple(parts)


def parse_meta(text: str) -> dict[str, str]:
    m = META_RE.search(text)
    if not m:
        return {}
    meta = {}
    for token in m.group(1).split():
        if "=" in token:
            key, value = token.split("=", 1)
            meta[key] = value
    return meta


def set_meta(text: str, meta: dict[str, str]) -> str:
    line = "<!-- supervised: " + " ".join(f"{k}={v}" for k, v in meta.items()) + " -->"
    if META_RE.search(text):
        return META_RE.sub(lambda _m: line, text, count=1)
    return line + "\n" + text


def title_of(text: str, fallback: str) -> str:
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return fallback


def unchecked_todos(text: str) -> list[str]:
    return [m.group(2) for m in TODO_RE.finditer(text) if m.group(1) == " "]


# ── 나무 스캔 ────────────────────────────────────────────────────


@dataclass
class Note:
    path: Path  # 노트 폴더 (root 기준 상대 경로, tree/...)
    branch: tuple[str, ...]
    title: str
    status: str  # "studying" | "done"
    started: str
    done: str | None


def scan(root: Path) -> list[Note]:
    tree = root / TREE_DIR
    if not tree.is_dir():
        return []
    notes = []
    for readme in sorted(tree.rglob("README.md")):
        text = readme.read_text(encoding="utf-8")
        meta = parse_meta(text)
        if "status" not in meta:
            continue
        rel = readme.parent.relative_to(root)
        notes.append(Note(
            path=rel,
            branch=rel.parts[1:-1],
            title=title_of(text, rel.name),
            status=meta["status"],
            started=meta.get("started", ""),
            done=meta.get("done"),
        ))
    return notes


# ── README 렌더링 ────────────────────────────────────────────────

START_MARK = "<!-- grow:start -->"
END_MARK = "<!-- grow:end -->"
README_HEADER = (
    "# 🌳 study-with-ai\n\n"
    "AI에게 지도받으며(supervised) 공부하고, 공부를 마칠 때마다 지식나무에 잎을 하나씩 쌓습니다.\n\n"
)


@dataclass
class _Branch:
    children: dict[str, "_Branch"] = field(default_factory=dict)
    leaves: list[str] = field(default_factory=list)


def mermaid_text(s: str) -> str:
    s = re.sub(r'[()\[\]{}<>"`]', "", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s or "?"


def md_escape(s: str) -> str:
    return re.sub(r"([\[\]|])", r"\\\1", s)


def _link(n: Note) -> str:
    return quote(n.path.as_posix() + "/README.md")


def _emit(node: _Branch, indent: int, out: list[str]) -> None:
    pad = " " * indent
    for name in sorted(node.children):
        out.append(pad + mermaid_text(name))
        _emit(node.children[name], indent + 2, out)
    for leaf in node.leaves:
        out.append(pad + "🍃 " + mermaid_text(leaf))


def render_block(notes: list[Note]) -> str:
    done = sorted((n for n in notes if n.status == "done"), key=lambda n: (n.done or "", str(n.path)))
    studying = [n for n in notes if n.status != "done"]
    branches = {n.branch[:i] for n in done for i in range(1, len(n.branch) + 1)}
    dates = [d for n in notes for d in (n.started, n.done) if d]
    last = max(dates) if dates else "-"

    out = [
        START_MARK, "",
        f"> 🍃 잎 **{len(done)}**개 · 🌿 가지 **{len(branches)}**개 · "
        f"🌱 공부 중 **{len(studying)}**개 · 📅 최근 공부 {last}",
        "", "## 🌳 지식나무", "",
        "```mermaid", "mindmap", "  root((🌳 study-with-ai))",
    ]
    top = _Branch()
    for n in done:
        node = top
        for b in n.branch:
            node = node.children.setdefault(b, _Branch())
        node.leaves.append(n.title)
    _emit(top, 4, out)
    out += ["```", ""]
    if not done:
        out += ["아직 잎이 없어요. 첫 공부를 마치면 여기에 🍃가 돋아나요.", ""]

    out += ["## 🌱 공부 중", ""]
    if studying:
        for n in studying:
            out.append(f"- [{md_escape(n.title)}]({_link(n)}) · {' / '.join(n.branch)} · {n.started} 시작")
    else:
        out.append("지금 공부 중인 노트가 없어요.")

    out += ["", "## 🍃 최근 쌓인 잎", ""]
    recent = list(reversed(done))[:10]
    if recent:
        out += ["| 날짜 | 가지 | 노트 |", "|---|---|---|"]
        for n in recent:
            out.append(f"| {n.done} | {md_escape(' / '.join(n.branch))} | [{md_escape(n.title)}]({_link(n)}) |")
    else:
        out.append("아직 없어요.")
    out += ["", END_MARK]
    return "\n".join(out)


def update_readme(root: Path, notes: list[Note]) -> Path:
    path = root / "README.md"
    block = render_block(notes)
    if path.exists():
        text = path.read_text(encoding="utf-8")
        s, e = text.find(START_MARK), text.find(END_MARK)
        if s != -1 and e > s:
            text = text[:s] + block + text[e + len(END_MARK):]
        else:
            text = text.rstrip("\n") + "\n\n" + block + "\n"
    else:
        text = README_HEADER + block + "\n"
    path.write_text(text, encoding="utf-8")
    return path
