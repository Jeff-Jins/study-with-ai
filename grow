#!/usr/bin/env python3
"""grow — study-with-ai 지식나무를 키우는 스크립트.

사용법:
  ./grow start "<가지 경로>" "<제목>"   학습 노트 만들기 (🌱 공부 중)
  ./grow done "<노트 경로>" [--force]   나무에 잎 추가 + 커밋 + push (🍃)
  ./grow refresh                      루트 README 다시 그리기
  ./grow list                         공부 중인 노트 보기
"""
from __future__ import annotations

import argparse
import datetime as dt
import os
import re
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path
from urllib.parse import quote

DEFAULT_ROOT = Path(__file__).resolve().parent
TREE_DIR = "tree"
FORBIDDEN = re.compile(r'[\\/:*?"<>|#%]')
META_RE = re.compile(r"<!--\s*supervised:(.*?)-->")
TODO_RE = re.compile(r"^[ \t]*[-*] \[( |x|X)\] (.+?)[ \t]*$", re.MULTILINE)


class GrowError(Exception):
    """사용자에게 그대로 보여줄 오류."""


# ── 노트 텍스트 파싱 ─────────────────────────────────────────────


def slugify(title: str) -> str:
    s = FORBIDDEN.sub("", title).strip()
    s = re.sub(r"\s+", "-", s)
    s = re.sub(r"-{2,}", "-", s).strip("-.")
    if not s:
        raise GrowError(f"제목으로 폴더 이름을 만들 수 없습니다: {title!r}")
    return s


def parse_branch(branch: str) -> tuple[str, ...]:
    parts = []
    for raw in re.split(r"[/\\]", branch):
        seg = re.sub(r"\s+", " ", FORBIDDEN.sub("", raw)).strip()
        if not seg:
            continue
        if set(seg) == {"."}:
            raise GrowError("가지 이름에 '.'이나 '..'은 쓸 수 없습니다")
        parts.append(seg)
    if not parts:
        raise GrowError('가지를 하나 이상 지정하세요. 예: "CS/네트워크"')
    return tuple(parts)


def parse_meta(text: str) -> dict[str, str]:
    m = META_RE.search(text)
    if not m:
        return {}
    meta = {}
    for token in m.group(1).split():
        if "=" in token:
            key, value = token.split("=", 1)
            meta[key] = value
    return meta


def set_meta(text: str, meta: dict[str, str]) -> str:
    line = "<!-- supervised: " + " ".join(f"{k}={v}" for k, v in meta.items()) + " -->"
    if META_RE.search(text):
        return META_RE.sub(lambda _m: line, text, count=1)
    return line + "\n" + text


def title_of(text: str, fallback: str) -> str:
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return fallback


def unchecked_todos(text: str) -> list[str]:
    return [m.group(2) for m in TODO_RE.finditer(text) if m.group(1) == " "]


# ── 나무 스캔 ────────────────────────────────────────────────────


@dataclass
class Note:
    path: Path  # 노트 폴더 (root 기준 상대 경로, tree/...)
    branch: tuple[str, ...]
    title: str
    status: str  # "studying" | "done"
    started: str
    done: str | None


def scan(root: Path) -> list[Note]:
    tree = root / TREE_DIR
    if not tree.is_dir():
        return []
    notes = []
    for readme in sorted(tree.rglob("README.md")):
        if "lab" in readme.parent.relative_to(tree).parts:
            continue
        try:
            text = readme.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
        meta = parse_meta(text)
        if "status" not in meta:
            continue
        rel = readme.parent.relative_to(root)
        notes.append(Note(
            path=rel,
            branch=rel.parts[1:-1],
            title=title_of(text, rel.name),
            status=meta["status"],
            started=meta.get("started", ""),
            done=meta.get("done"),
        ))
    return notes


# ── README 렌더링 ────────────────────────────────────────────────

START_MARK = "<!-- grow:start -->"
END_MARK = "<!-- grow:end -->"
README_HEADER = (
    "# 🌳 study-with-ai\n\n"
    "AI에게 지도받으며(supervised) 공부하고, 공부를 마칠 때마다 지식나무에 잎을 하나씩 쌓습니다.\n\n"
)


@dataclass
class _Branch:
    children: dict[str, "_Branch"] = field(default_factory=dict)
    leaves: list[str] = field(default_factory=list)


def mermaid_text(s: str) -> str:
    s = re.sub(r'[()\[\]{}<>"`]', "", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s or "?"


def md_escape(s: str) -> str:
    return re.sub(r"([\[\]|])", r"\\\1", s)


def _link(n: Note) -> str:
    return quote(n.path.as_posix() + "/README.md")


def _emit(node: _Branch, indent: int, out: list[str]) -> None:
    pad = " " * indent
    for name in sorted(node.children):
        out.append(pad + mermaid_text(name))
        _emit(node.children[name], indent + 2, out)
    for leaf in node.leaves:
        out.append(pad + "🍃 " + mermaid_text(leaf))


def render_block(notes: list[Note]) -> str:
    done = sorted((n for n in notes if n.status == "done"), key=lambda n: (n.done or "", str(n.path)))
    studying = [n for n in notes if n.status != "done"]
    branches = {n.branch[:i] for n in done for i in range(1, len(n.branch) + 1)}
    dates = [d for n in notes for d in (n.started, n.done) if d]
    last = max(dates) if dates else "-"

    out = [
        START_MARK, "",
        f"> 🍃 잎 **{len(done)}**개 · 🌿 가지 **{len(branches)}**개 · "
        f"🌱 공부 중 **{len(studying)}**개 · 📅 최근 공부 {last}",
        "", "## 🌳 지식나무", "",
        "```mermaid", "mindmap", "  root((🌳 study-with-ai))",
    ]
    top = _Branch()
    for n in done:
        node = top
        for b in n.branch:
            node = node.children.setdefault(b, _Branch())
        node.leaves.append(n.title)
    _emit(top, 4, out)
    out += ["```", ""]
    if not done:
        out += ["아직 잎이 없어요. 첫 공부를 마치면 여기에 🍃가 돋아나요.", ""]

    out += ["## 🌱 공부 중", ""]
    if studying:
        for n in studying:
            out.append(f"- [{md_escape(n.title)}]({_link(n)}) · {' / '.join(n.branch)} · {n.started} 시작")
    else:
        out.append("지금 공부 중인 노트가 없어요.")

    out += ["", "## 🍃 최근 쌓인 잎", ""]
    recent = list(reversed(done))[:10]
    if recent:
        out += ["| 날짜 | 가지 | 노트 |", "|---|---|---|"]
        for n in recent:
            out.append(f"| {n.done} | {md_escape(' / '.join(n.branch))} | [{md_escape(n.title)}]({_link(n)}) |")
    else:
        out.append("아직 없어요.")
    out += ["", END_MARK]
    return "\n".join(out)


def update_readme(root: Path, notes: list[Note]) -> Path:
    path = root / "README.md"
    block = render_block(notes)
    if path.exists():
        text = path.read_text(encoding="utf-8")
        s = text.find(START_MARK)
        e = text.find(END_MARK, s) if s != -1 else -1
        if s != -1 and e != -1:
            text = text[:s] + block + text[e + len(END_MARK):]
        elif s == -1 and END_MARK not in text:
            text = text.rstrip("\n") + "\n\n" + block + "\n"
        else:
            raise GrowError("README의 grow 마커가 깨졌어요. <!-- grow:start --> 와 "
                            "<!-- grow:end --> 를 한 쌍으로 고친 뒤 다시 실행하세요.")
    else:
        text = README_HEADER + block + "\n"
    path.write_text(text, encoding="utf-8")
    return path


# ── git ─────────────────────────────────────────────────────────


def _git(root: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess:
    r = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise GrowError(f"git {' '.join(args)} 실패:\n{r.stderr.strip()}")
    return r


def commit(root: Path, message: str) -> None:
    _git(root, "add", "-A", "--", TREE_DIR, "README.md")
    _git(root, "commit", "-q", "-m", message, "--", TREE_DIR, "README.md")


def push(root: Path) -> bool:
    remotes = _git(root, "remote").stdout.split()
    if not remotes:
        print("ℹ️  remote가 없어 push를 건너뜁니다. (git remote add origin <URL>)")
        return False
    remote = "origin" if "origin" in remotes else remotes[0]
    try:
        r = subprocess.run(
            ["git", "-C", str(root), "push", "-u", remote, "HEAD"],
            capture_output=True, text=True, timeout=120,
            env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
    except subprocess.TimeoutExpired:
        print("⚠️  push 실패 (커밋은 남아 있어요):\n시간 초과 (120초)", file=sys.stderr)
        return False
    if r.returncode != 0:
        print(f"⚠️  push 실패 (커밋은 남아 있어요):\n{r.stderr.strip()}", file=sys.stderr)
        return False
    return True


# ── 명령 ────────────────────────────────────────────────────────

NOTE_TEMPLATE = """<!-- supervised: status=studying started={today} -->
# {title}

> 가지: {branch}

## 개념 설명

## 핵심 요약

## 참고자료

## TODO 실습

## 질문과 답

공부하면서 생긴 질문은 [QnA.md](QnA.md)에 정리해요.
"""

QNA_TEMPLATE = """# 질문과 답 — {title}

> 노트: [README.md](README.md)
"""


def start(root: Path, branch: str, title: str, today: str) -> Path:
    root = Path(root).resolve()
    parts = parse_branch(branch)
    title = " ".join(title.split())
    slug = slugify(title)
    if len(slug.encode("utf-8")) > 200:
        slug = slug.encode("utf-8")[:200].decode("utf-8", "ignore").rstrip("-.")
    note_dir = root / TREE_DIR / Path(*parts) / f"{today}-{slug}"
    if note_dir.exists():
        raise GrowError(f"이미 있는 노트입니다: {note_dir.relative_to(root)}")
    note_dir.mkdir(parents=True)
    (note_dir / "README.md").write_text(
        NOTE_TEMPLATE.format(today=today, title=title, branch=" / ".join(parts)), encoding="utf-8")
    (note_dir / "QnA.md").write_text(QNA_TEMPLATE.format(title=title), encoding="utf-8")
    update_readme(root, scan(root))
    commit(root, f"🌱 start: {' / '.join(parts)} / {title}")
    return note_dir


def resolve_note(root: Path, arg: str) -> Path:
    root = Path(root).resolve()
    tree = (root / TREE_DIR).resolve()
    p = Path(arg).expanduser()
    candidates = [p] if p.is_absolute() else [Path.cwd() / p, root / p, tree / p]
    for c in candidates:
        if c.name == "README.md":
            c = c.parent
        c = c.resolve()
        readme = c / "README.md"
        if (c.is_relative_to(tree) and readme.is_file()
                and "status" in parse_meta(readme.read_text(encoding="utf-8"))):
            return c
    raise GrowError(f"노트를 찾을 수 없습니다: {arg}")


def done(root: Path, arg: str, today: str, force: bool = False) -> Note:
    root = Path(root).resolve()
    note_dir = resolve_note(root, arg)
    readme = note_dir / "README.md"
    text = readme.read_text(encoding="utf-8")
    meta = parse_meta(text)
    if meta.get("status") == "done":
        raise GrowError(f"이미 완료한 노트입니다 ({meta.get('done', '?')})")
    left = unchecked_todos(text)
    if left and not force:
        listing = "\n".join(f"  - [ ] {t}" for t in left)
        raise GrowError(f"아직 체크 안 된 TODO가 있어요:\n{listing}\n모두 끝냈다면 체크하거나 --force를 붙이세요.")
    meta["status"] = "done"
    meta["done"] = today
    readme.write_text(set_meta(text, meta), encoding="utf-8")
    notes = scan(root)
    update_readme(root, notes)
    rel = note_dir.relative_to(root)
    note = next(n for n in notes if n.path == rel)
    commit(root, f"🍃 grow: {' / '.join(note.branch)} / {note.title}")
    push(root)
    return note


# ── CLI ─────────────────────────────────────────────────────────


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="grow", description="study-with-ai 지식나무 관리")
    ap.add_argument("--root", type=Path, default=DEFAULT_ROOT, help=argparse.SUPPRESS)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("start", help="학습 노트 만들기 (🌱)")
    p.add_argument("branch", help='가지 경로. 예: "CS/네트워크/TCP"')
    p.add_argument("title", help="노트 제목")
    p = sub.add_parser("done", help="공부 완료 → 나무에 잎 추가 (🍃)")
    p.add_argument("note", help="노트 폴더 또는 README 경로")
    p.add_argument("--force", action="store_true", help="체크 안 된 TODO가 있어도 완료")
    sub.add_parser("refresh", help="루트 README 다시 그리기")
    sub.add_parser("list", help="공부 중인 노트 보기")
    args = ap.parse_args(argv)

    root = args.root.resolve()
    today = dt.date.today().isoformat()
    try:
        if args.cmd == "start":
            d = start(root, args.branch, args.title, today)
            print(f"🌱 노트를 만들었어요: {d.relative_to(root)}/README.md")
        elif args.cmd == "done":
            n = done(root, args.note, today, force=args.force)
            leaves = sum(1 for x in scan(root) if x.status == "done")
            print(f"🍃 나무에 잎이 돋았어요: {' / '.join(n.branch)} / {n.title} (총 {leaves}개)")
        elif args.cmd == "refresh":
            update_readme(root, scan(root))
            print("README를 다시 그렸어요.")
        else:
            studying = [n for n in scan(root) if n.status != "done"]
            if not studying:
                print("공부 중인 노트가 없어요.")
            for n in studying:
                print(f"{n.path.as_posix()}  ({' / '.join(n.branch)} · {n.title} · {n.started} 시작)")
    except GrowError as e:
        print(f"오류: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
